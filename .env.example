# Gemini Studio (preferred). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional Anthropic fallback if GEMINI_API_KEY is empty
ANTHROPIC_API_KEY=

# e.g. gemini-2.5-flash, claude-sonnet-4-5
LLM_MODEL=gemini-2.5-flash

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Default: George (clear UK-style male). Swap in the dashboard if you prefer another voice.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Optional live UK jobs (https://www.reed.co.uk/developers)
REED_API_KEY=

# HTTP timeouts (seconds)
HTTP_TIMEOUT=45
